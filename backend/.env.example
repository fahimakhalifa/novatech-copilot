# Copy to .env and fill in. Never commit .env.

# --- LLM providers (both free, no card) ---
GOOGLE_API_KEY=
GROQ_API_KEY=

# Model chains, comma-separated: primary first, then fallbacks.
AGENT_MODELS=google_genai:gemini-3.5-flash-lite,google_genai:gemini-3.1-flash-lite,groq:qwen/qwen3.8-27b
FAST_MODELS=google_genai:gemini-3.5-flash-lite,google_genai:gemini-3.1-flash-lite,groq:qwen/qwen3.8-27b
JUDGE_MODEL=groq:openai/gpt-oss-120b

# --- Local models (free, run on your machine) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# --- Storage (optional overrides) ---
# Defaults are in app/config.py; uncomment to override.
# DATABASE_URL=sqlite:///./data/novatech.db
# QDRANT_URL=http://localhost:6333
# QDRANT_PATH=./data/qdrant
# QDRANT_COLLECTION=novatech_docs
# CHECKPOINT_DB=./data/checkpoints.sqlite

# --- Telegram (optional extra) ---
TELEGRAM_BOT_TOKEN=

# --- API ---
# Signs login tokens. Generate: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=
CORS_ORIGINS=http://localhost:5173
BOT_SECRET=
